*.runs/
*.cache/
*.gen/
*.hw/
*.sim/
*.ip_user_files/
*.srcs/

# Vivado temporary/generated files
*.jou
*.log
*.str
*.pb
*.xmsgs
*.xml
*.rpt
*.rpx

# Vivado checkpoints
*.dcp

# Vivado generated simulation files
*.wdb
*.wcfg
*.xsim
*.xsim.dir/
xsim.dir/

# Vivado generated output/programming files
*.bit
*.bin
*.ltx
*.mcs
*.prm
*.pdi
*.xsa
*.hdf


